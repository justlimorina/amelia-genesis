/*
 * Calamares Material Design 3 (MD3) Theme for Amelia
 */

/* Main Calamares Window & Containers */
QMainWindow, QDialog, CalamaresWindow {
    background-color: #f8f9fe;
    color: #1c1b1e;
    font-family: "Adwaita Sans", "Cantarell", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: transparent;
    color: #1c1b1e;
    font-family: "Adwaita Sans", "Cantarell", sans-serif;
    font-size: 13px;
}

/* Sidebar Styling */
#sidebarWidget, QFrame#sidebarWidget, #sidebarApp, QFrame#sidebarApp {
    background-color: #f0edf6;
    border-right: 1px solid #e0dce8;
    min-width: 220px;
}

#sidebarWidget QLabel, #sidebarApp QLabel {
    color: #1c1b1e;
}

#sidebarWidget QTreeView, #sidebarApp QTreeView {
    background-color: transparent;
    border: none;
    outline: none;
}

#sidebarWidget QTreeView::item, #sidebarApp QTreeView::item {
    padding: 10px 16px;
    border-radius: 18px;
    margin: 4px 8px;
    color: #49454e;
    font-weight: 500;
}

#sidebarWidget QTreeView::item:hover, #sidebarApp QTreeView::item:hover {
    background-color: #e7e0ec;
    color: #1c1b1e;
}

#sidebarWidget QTreeView::item:selected, #sidebarApp QTreeView::item:selected {
    background-color: #e8ddff;
    color: #22005d;
    font-weight: bold;
}

/* Content Area */
#mainApp, QStackedWidget {
    background-color: #f8f9fe;
}

/* Header & Titles */
QLabel#mainText, QLabel#titleText {
    color: #6650a4;
    font-size: 18px;
    font-weight: bold;
}

/* Buttons - Material 3 Style */
QPushButton {
    background-color: #6650a4;
    color: #ffffff;
    border: none;
    border-radius: 18px;
    padding: 8px 22px;
    font-weight: bold;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #7864b8;
}

QPushButton:pressed {
    background-color: #533d90;
}

QPushButton:disabled {
    background-color: #e7e0ec;
    color: #7a757f;
}

/* Action Buttons at Bottom Bar */
QPushButton#backButton, QPushButton#cancelButton, QPushButton#nextButton {
    min-width: 80px;
}

QPushButton#backButton, QPushButton#cancelButton {
    background-color: #e8def8;
    color: #1d192b;
    border: none;
}

QPushButton#backButton:hover, QPushButton#cancelButton:hover {
    background-color: #d8cde8;
}

/* Input Fields & Comboboxes */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    color: #1c1b1e;
    border: 1px solid #cac4cf;
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: #e8ddff;
    selection-color: #22005d;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #6650a4;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

/* Progress Bar */
QProgressBar {
    background-color: #e7e0ec;
    border-radius: 8px;
    text-align: center;
    color: #1c1b1e;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #6650a4;
    border-radius: 8px;
}

/* Checkboxes & Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1c1b1e;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #7a757f;
    border-radius: 4px;
    background-color: #ffffff;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #6650a4;
    border-color: #6650a4;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #f0edf6;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #cac4cf;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7a757f;
}

/* GroupBox / Card Containers */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e0dce8;
    border-radius: 12px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
    color: #1c1b1e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #6650a4;
}
