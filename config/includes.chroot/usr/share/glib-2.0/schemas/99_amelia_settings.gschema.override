[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/amelia/amelia_wallpaper.jpeg'
picture-uri-dark='file:///usr/share/backgrounds/amelia/amelia_wallpaper.jpeg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/amelia/amelia_wallpaper.jpeg'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='purple'
icon-theme='Papirus'
font-name='Adwaita Sans 11'
document-font-name='Adwaita Sans 11'
monospace-font-name='Adwaita Mono 11'

[org.gnome.desktop.wm.preferences]
titlebar-font='Adwaita Sans Bold 11'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.software]
first-run=false
official-repos=['flathub']
packaging-format-preference=['flatpak:flathub', 'flatpak', 'deb']
prompt-for-nonfree=false

[org.gnome.shell]
favorite-apps=['install-amelia.desktop', 'amelia-welcome.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.Ptyxis.desktop']
enabled-extensions=['dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'appindicatorsupport@rgcjonas.gmail.com', 'ding@rastersoft.com', 'add-to-desktop@tommimon.github.com']

[org.gnome.shell.extensions.dash-to-panel]
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
appicon-margin=1
appicon-padding=8
dot-color-dominant=true
dot-color-override=false
dot-color-unfocused-different=false
dot-position='BOTTOM'
extension-version=74
focus-highlight-dominant=true
hotkeys-overlay-combo='TEMPORARILY'
panel-anchors='{"0":"MIDDLE","BOE-0x00000000":"MIDDLE"}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"BOE-0x00000000":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-lengths='{}'
panel-positions='{"0":"TOP","BOE-0x00000000":"TOP"}'
panel-sizes='{}'
prefs-opened=true
window-preview-title-position='TOP'

[org.gnome.shell.extensions.arcmenu]
apps-show-generic-names=false
icon-size-apps=-1
icon-size-buttons=-1
icon-size-categories=-1
icon-size-grid={'width': -1, 'height': -1, 'size': -1}
icon-size-misc=-1
icon-size-shortcuts=-1
menu-button-border-radius=(true, 0)
menu-button-border-width=(true, 5)
menu-button-icon='/usr/share/pixmaps/amelia-logo-symbolic.svg'
menu-button-icon-size=29
menu-button-padding=12
menu-button-position-offset=10
menu-layout='windows'
pinned-apps=[{'id': 'org.gnome.Nautilus.desktop'}, {'id': 'google-chrome.desktop'}, {'id': 'onlyoffice-desktopeditors.desktop'}]
search-entry-border-radius=(true, 25)
search-hidden=false
show-hidden-recent-files=false
vert-separator=true

[org.gnome.shell.extensions.ding]
show-home=true
show-trash=true
icon-size='standard'
show-drop-place=true

[org.gnome.shell.extensions.appindicator]
tray-pos='right'
icon-size=0
legacy-tray-enabled=true
