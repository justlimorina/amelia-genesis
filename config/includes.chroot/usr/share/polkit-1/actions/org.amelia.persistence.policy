<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Amelia</vendor>
  <vendor_url>https://github.com/justlimorina/amelia-genesis</vendor_url>
  <icon_name>amelia_logo</icon_name>

  <action id="org.amelia.persistence.init">
    <description>Initialize USB Live Persistence for Amelia</description>
    <description xml:lang="vi">Khởi tạo phân vùng lưu phiên USB cho Amelia</description>
    <message>Authentication is required to configure persistence.conf on the USB persistence volume.</message>
    <message xml:lang="vi">Cần xác thực để ghi tệp cấu hình persistence.conf lên phân vùng lưu phiên USB.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/amelia-init-persistence</annotate>
  </action>
</policyconfig>

