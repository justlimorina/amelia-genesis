CUSTOM_CSS = """
.amelia-badge {
    padding: 5px 14px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85em;
    background-color: alpha(#6750A4, 0.18);
    color: #D0BCFF;
}
window.light-mode .amelia-badge {
    background-color: alpha(#6750A4, 0.12);
    color: #4F378B;
}
.amelia-badge-persist {
    background-color: alpha(#7D5260, 0.28);
}
"""


def detect_boot_mode() -> str:
    """Return 'live', 'persistence', or 'installed'."""
    cmdline = ""
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8", errors="ignore")
    except OSError:
        pass

    tokens = cmdline.split()
    if "boot=live" not in tokens:
        return "installed"

    try:
        mounts = Path("/proc/mounts").read_text(encoding="utf-8", errors="ignore")
        for line in mounts.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1].startswith("/run/live/persistence/"):
                return "persistence"
    except OSError:
        pass

    return "live"


def detect_initial_lang() -> str:
    env_lang = os.environ.get("LANG", "") or os.environ.get("LC_ALL", "")
    if not env_lang:
        try:
            env_lang = locale.getlocale()[0] or ""
        except Exception:
            env_lang = ""
    return "vi" if env_lang.lower().startswith("vi") else "en"


def is_onlyoffice_installed() -> bool:
    exports = [
        Path("/var/lib/flatpak/exports/share/applications/org.onlyoffice.desktopeditors.desktop"),
        Path.home() / ".local/share/flatpak/exports/share/applications/org.onlyoffice.desktopeditors.desktop",
    ]
    if any(p.exists() for p in exports):
        return True
    if shutil.which("flatpak"):
        res = subprocess.run(
            ["flatpak", "info", ONLYOFFICE_ID],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    return False


def apply_onlyoffice_mime_defaults() -> None:
    if not shutil.which("xdg-mime"):
        return
    desktop_id = f"{ONLYOFFICE_ID}.desktop"
    for mime in OFFICE_MIMES:
        subprocess.run(
            ["xdg-mime", "default", desktop_id, mime],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def disable_flag_path() -> Path:
    cfg = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    return cfg / "amelia" / "welcome-disabled"


class AmeliaWelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application) -> None:
        super().__init__(application=app)
        self.set_default_size(680, 660)
        self.set_size_request(360, 480)

        self.boot_mode = detect_boot_mode()
        self.lang = detect_initial_lang()
        self.oo_installing = False
        self.oo_installed = is_onlyoffice_installed()

        self.style_mgr = Adw.StyleManager.get_default()
        self.style_mgr.connect("notify::dark", self._on_theme_changed)

        self.toast_overlay = Adw.ToastOverlay()
        self.nav_view = Adw.NavigationView()
        self.toast_overlay.set_child(self.nav_view)
        self.set_content(self.toast_overlay)

        self._load_css()
        self._build_ui()
        self._sync_theme_visuals()

    def t(self, key: str) -> str:
        return STRINGS[self.lang][key]

    def _load_css(self) -> None:
        provider = Gtk.CssProvider()
        provider.load_from_string(CUSTOM_CSS)
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def _build_ui(self) -> None:
        # Clear nav stack and rebuild cleanly on language switch
        main_page = self._create_main_page()
        self.nav_view.replace([main_page])
        self.set_title(self.t("window_title"))

    def _create_main_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()

        lang_btn = Gtk.Button(label=self.t("lang_toggle"))
        lang_btn.set_tooltip_text(self.t("lang_tooltip"))
        lang_btn.add_css_class("flat")
        lang_btn.connect("clicked", self._on_toggle_language)
        header.pack_end(lang_btn)
        toolbar_view.add_top_bar(header)

        if self.boot_mode == "persistence":
            banner = Adw.Banner(title=self.t("persist_banner"))
            banner.set_revealed(True)
            toolbar_view.add_top_bar(banner)

        pref_page = Adw.PreferencesPage()

        # Hero Branding Group
        hero_group = Adw.PreferencesGroup()
        hero_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        hero_box.set_margin_top(6)
        hero_box.set_margin_bottom(8)
        hero_box.set_halign(Gtk.Align.CENTER)

        self.logo_picture = Gtk.Picture()
        self.logo_picture.set_can_shrink(False)
        self.logo_picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.logo_picture.set_halign(Gtk.Align.CENTER)
        self._update_logo_file()
        hero_box.append(self.logo_picture)

        badge_key = {
            "live": "badge_live",
            "persistence": "badge_persist",
            "installed": "badge_installed",
        }[self.boot_mode]
        badge = Gtk.Label(label=self.t(badge_key))
        badge.add_css_class("amelia-badge")
        if self.boot_mode == "persistence":
            badge.add_css_class("amelia-badge-persist")
        badge.set_halign(Gtk.Align.CENTER)
        hero_box.append(badge)

        sub_key = {
            "live": "hero_subtitle_live",
            "persistence": "hero_subtitle_persist",
            "installed": "hero_subtitle_installed",
        }[self.boot_mode]
        subtitle = Gtk.Label(label=self.t(sub_key))
        subtitle.set_wrap(True)
        subtitle.set_justify(Gtk.Justification.CENTER)
        subtitle.set_max_width_chars(58)
        subtitle.add_css_class("dim-label")
        hero_box.append(subtitle)

        hero_group.add(hero_box)
        pref_page.add(hero_group)

        # 1. System Action Group
        sys_group = Adw.PreferencesGroup(title=self.t("group_system"))
        if self.boot_mode in ("live", "persistence"):
            install_row = Adw.ActionRow(
                title=self.t("install_title"),
                subtitle=self.t("install_sub"),
            )
            install_row.add_prefix(Gtk.Image.new_from_icon_name("drive-harddisk-system-symbolic"))
            install_btn = Gtk.Button(label=self.t("install_btn"))
            install_btn.set_valign(Gtk.Align.CENTER)
            install_btn.add_css_class("suggested-action")
            install_btn.connect("clicked", lambda *_: self._spawn(["/usr/local/bin/install-amelia"]))
            install_row.add_suffix(install_btn)
            install_row.set_activatable_widget(install_btn)
            sys_group.add(install_row)
        else:
            upd_row = Adw.ActionRow(
                title=self.t("update_title"),
                subtitle=self.t("update_sub"),
            )
            upd_row.add_prefix(Gtk.Image.new_from_icon_name("software-update-available-symbolic"))
            upd_btn = Gtk.Button(label=self.t("update_btn"))
            upd_btn.set_valign(Gtk.Align.CENTER)
            upd_btn.add_css_class("suggested-action")
            upd_btn.connect("clicked", lambda *_: self._spawn(["gnome-software", "--mode=updates"]))
            upd_row.add_suffix(upd_btn)
            upd_row.set_activatable_widget(upd_btn)
            sys_group.add(upd_row)
        pref_page.add(sys_group)

        # 2. Essential Apps Group (ONLYOFFICE + Software Center)
        apps_group = Adw.PreferencesGroup(title=self.t("group_apps"))

        self.oo_row = Adw.ActionRow(
            title=self.t("oo_title"),
            subtitle=self.t("oo_sub_installed") if self.oo_installed else self.t("oo_sub"),
        )
        self.oo_row.add_prefix(Gtk.Image.new_from_icon_name("x-office-document-symbolic"))

        oo_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        oo_btn_box.set_valign(Gtk.Align.CENTER)

        self.oo_spinner = Gtk.Spinner()
        self.oo_spinner.set_visible(self.oo_installing)
        if self.oo_installing:
            self.oo_spinner.start()
        oo_btn_box.append(self.oo_spinner)

        if not self.oo_installed:
            self.oo_store_btn = Gtk.Button(label=self.t("oo_store_btn"))
            self.oo_store_btn.set_valign(Gtk.Align.CENTER)
            self.oo_store_btn.connect(
                "clicked",
                lambda *_: self._spawn(["gnome-software", f"--details={ONLYOFFICE_ID}"]),
            )
            oo_btn_box.append(self.oo_store_btn)

        self.oo_primary_btn = Gtk.Button(
            label=self.t("oo_open_btn")
            if self.oo_installed
            else (self.t("oo_installing_btn") if self.oo_installing else self.t("oo_install_btn"))
        )
        self.oo_primary_btn.set_valign(Gtk.Align.CENTER)
        self.oo_primary_btn.set_sensitive(not self.oo_installing)
        if not self.oo_installed:
            self.oo_primary_btn.add_css_class("suggested-action")
        self.oo_primary_btn.connect("clicked", self._on_onlyoffice_primary_clicked)
        oo_btn_box.append(self.oo_primary_btn)

        self.oo_row.add_suffix(oo_btn_box)
        apps_group.add(self.oo_row)

        store_row = Adw.ActionRow(
            title=self.t("store_title"),
            subtitle=self.t("store_sub"),
        )
        store_row.add_prefix(Gtk.Image.new_from_icon_name("system-software-install-symbolic"))
        store_btn = Gtk.Button(label=self.t("store_btn"))
        store_btn.set_valign(Gtk.Align.CENTER)
        store_btn.connect("clicked", lambda *_: self._spawn(["gnome-software"]))
        store_row.add_suffix(store_btn)
        store_row.set_activatable_widget(store_btn)
        apps_group.add(store_row)

        pref_page.add(apps_group)

        # 3. Guides & Support Group
        guides_group = Adw.PreferencesGroup(title=self.t("group_guides"))

        if self.boot_mode in ("live", "persistence"):
            persist_row = Adw.ActionRow(
                title=self.t("persist_row_title"),
                subtitle=self.t("persist_row_sub"),
                activatable=True,
            )
            persist_row.add_prefix(Gtk.Image.new_from_icon_name("media-removable-symbolic"))
            persist_row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
            persist_row.connect("activated", lambda *_: self.nav_view.push(self._create_persistence_page()))
            guides_group.add(persist_row)

        hw_row = Adw.ActionRow(
            title=self.t("hw_row_title"),
            subtitle=self.t("hw_row_sub"),
            activatable=True,
        )
        hw_row.add_prefix(Gtk.Image.new_from_icon_name("network-wireless-symbolic"))
        hw_row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        hw_row.connect("activated", lambda *_: self.nav_view.push(self._create_hardware_page()))
        guides_group.add(hw_row)

        bug_row = Adw.ActionRow(
            title=self.t("bug_row_title"),
            subtitle=self.t("bug_row_sub"),
        )
        bug_row.add_prefix(Gtk.Image.new_from_icon_name("bug-symbolic"))
        bug_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bug_box.set_valign(Gtk.Align.CENTER)

        copy_btn = Gtk.Button(label=self.t("bug_copy_btn"))
        copy_btn.connect("clicked", self._on_copy_sysinfo)
        bug_box.append(copy_btn)

        report_btn = Gtk.Button(label=self.t("bug_open_btn"))
        report_btn.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(ISSUE_URL, None))
        bug_box.append(report_btn)

        bug_row.add_suffix(bug_box)
        guides_group.add(bug_row)
        pref_page.add(guides_group)

        # 4. Startup Preference Group
        pref_group = Adw.PreferencesGroup()
        startup_row = Adw.SwitchRow(
            title=self.t("startup_title"),
            subtitle=self.t("startup_sub"),
        )
        startup_row.set_active(not disable_flag_path().exists())
        startup_row.connect("notify::active", self._on_startup_toggled)
        pref_group.add(startup_row)
        pref_page.add(pref_group)

        toolbar_view.set_content(pref_page)
        return Adw.NavigationPage.new(toolbar_view, self.t("window_title"))

    def _create_persistence_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        warn_group = Adw.PreferencesGroup()
        warn_row = Adw.ActionRow(
            title=self.t("persist_privacy_title"),
            subtitle=self.t("persist_privacy_desc"),
        )
        warn_row.add_prefix(Gtk.Image.new_from_icon_name("dialog-warning-symbolic"))
        warn_group.add(warn_row)
        page.add(warn_group)

        steps_group = Adw.PreferencesGroup(title=self.t("persist_steps_group"))

        step1 = Adw.ActionRow(
            title=self.t("persist_step1_title"),
            subtitle=self.t("persist_step1_sub"),
        )
        s1_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        s1_box.set_valign(Gtk.Align.CENTER)
        disks_btn = Gtk.Button(label=self.t("persist_disks_btn"))
        disks_btn.connect("clicked", lambda *_: self._spawn(["gnome-disks"]))
        s1_box.append(disks_btn)
        if shutil.which("gparted"):
            gp_btn = Gtk.Button(label=self.t("persist_gparted_btn"))
            gp_btn.connect("clicked", lambda *_: self._spawn(["pkexec", "gparted"]))
            s1_box.append(gp_btn)
        step1.add_suffix(s1_box)
        steps_group.add(step1)

        step2 = Adw.ActionRow(
            title=self.t("persist_step2_title"),
            subtitle=self.t("persist_step2_sub"),
        )
        init_btn = Gtk.Button(label=self.t("persist_init_btn"))
        init_btn.set_valign(Gtk.Align.CENTER)
        init_btn.add_css_class("suggested-action")
        init_btn.connect("clicked", self._on_init_persistence)
        step2.add_suffix(init_btn)
        steps_group.add(step2)

        step3 = Adw.ActionRow(
            title=self.t("persist_step3_title"),
            subtitle=self.t("persist_step3_sub"),
        )
        steps_group.add(step3)

        page.add(steps_group)
        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("persist_page_title"))

    def _create_hardware_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        net_group = Adw.PreferencesGroup(title=self.t("hw_net_group"))
        for title_k, sub_k, icon_name, panel in [
            ("hw_wifi_title", "hw_wifi_sub", "network-wireless-symbolic", "wifi"),
            ("hw_net_title", "hw_net_sub", "network-wired-symbolic", "network"),
            ("hw_bt_title", "hw_bt_sub", "bluetooth-active-symbolic", "bluetooth"),
        ]:
            row = Adw.ActionRow(title=self.t(title_k), subtitle=self.t(sub_k))
            row.add_prefix(Gtk.Image.new_from_icon_name(icon_name))
            btn = Gtk.Button(label=self.t("open_settings_btn"))
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("clicked", lambda _b, p=panel: self._spawn(["gnome-control-center", p]))
            row.add_suffix(btn)
            row.set_activatable_widget(btn)
            net_group.add(row)
        page.add(net_group)

        gpu_group = Adw.PreferencesGroup(title=self.t("hw_gpu_group"))
        disp_row = Adw.ActionRow(
            title=self.t("hw_disp_title"),
            subtitle=self.t("hw_disp_sub"),
        )
        disp_row.add_prefix(Gtk.Image.new_from_icon_name("video-display-symbolic"))
        disp_btn = Gtk.Button(label=self.t("open_settings_btn"))
        disp_btn.set_valign(Gtk.Align.CENTER)
        disp_btn.connect("clicked", lambda *_: self._spawn(["gnome-control-center", "display"]))
        disp_row.add_suffix(disp_btn)
        disp_row.set_activatable_widget(disp_btn)
        gpu_group.add(disp_row)

        drv_row = Adw.ActionRow(
            title=self.t("hw_drv_title"),
            subtitle=self.t("hw_drv_sub"),
        )
        drv_row.add_prefix(Gtk.Image.new_from_icon_name("preferences-desktop-display-symbolic"))
        gpu_group.add(drv_row)
        page.add(gpu_group)

        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("hw_page_title"))

    def _update_logo_file(self) -> None:
        if not hasattr(self, "logo_picture"):
            return
        candidate = DARK_WORDMARK if self.style_mgr.get_dark() else LIGHT_WORDMARK
        if not os.path.exists(candidate):
            candidate = FALLBACK_WORDMARK
        if os.path.exists(candidate):
            self.logo_picture.set_filename(candidate)

    def _sync_theme_visuals(self) -> None:
        if self.style_mgr.get_dark():
            self.remove_css_class("light-mode")
        else:
            self.add_css_class("light-mode")
        self._update_logo_file()

    def _on_theme_changed(self, *_args: object) -> None:
        self._sync_theme_visuals()

    def _on_toggle_language(self, *_args: object) -> None:
        self.lang = "en" if self.lang == "vi" else "vi"
        self.oo_installed = is_onlyoffice_installed()
        self._build_ui()
        self._sync_theme_visuals()

    def _on_startup_toggled(self, switch_row: Adw.SwitchRow, _pspec: object) -> None:
        flag = disable_flag_path()
        try:
            if switch_row.get_active():
                flag.unlink(missing_ok=True)
            else:
                flag.parent.mkdir(parents=True, exist_ok=True)
                flag.write_text("disabled\n", encoding="utf-8")
        except OSError:
            pass

    def _on_onlyoffice_primary_clicked(self, *_args: object) -> None:
        if is_onlyoffice_installed():
            self.oo_installed = True
            apply_onlyoffice_mime_defaults()
            self._spawn(["flatpak", "run", ONLYOFFICE_ID])
            return

        if self.oo_installing:
            return

        self.oo_installing = True
        self.oo_primary_btn.set_sensitive(False)
        self.oo_primary_btn.set_label(self.t("oo_installing_btn"))
        self.oo_spinner.set_visible(True)
        self.oo_spinner.start()
        self._show_toast(self.t("toast_oo_start"))

        def worker() -> None:
            rc = 1
            if shutil.which("flatpak"):
                proc = subprocess.run(
                    ["flatpak", "install", "--noninteractive", "-y", "flathub", ONLYOFFICE_ID],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    check=False,
                )
                rc = proc.returncode
                if rc != 0:
                    # Fallback to user installation if system-wide polkit was dismissed
                    proc_user = subprocess.run(
                        [
                            "flatpak",
                            "remote-add",
                            "--user",
                            "--if-not-exists",
                            "flathub",
                            "/etc/flatpak/remotes.d/flathub.flatpakrepo",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False,
                    )
                    if proc_user.returncode == 0:
                        proc2 = subprocess.run(
                            [
                                "flatpak",
                                "install",
                                "--user",
                                "--noninteractive",
                                "-y",
                                "flathub",
                                ONLYOFFICE_ID,
                            ],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT,
                            text=True,
                            check=False,
                        )
                        rc = proc2.returncode

            GLib.idle_add(self._on_onlyoffice_install_finished, rc == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _on_onlyoffice_install_finished(self, ok: bool) -> bool:
        self.oo_installing = False
        self.oo_installed = ok or is_onlyoffice_installed()
        if self.oo_installed:
            apply_onlyoffice_mime_defaults()
            self._show_toast(self.t("toast_oo_done"))
        else:
            self._show_toast(self.t("toast_oo_fail"))
        self._build_ui()
        self._sync_theme_visuals()
        return GLib.SOURCE_REMOVE

    def _on_init_persistence(self, btn: Gtk.Button) -> None:
        btn.set_sensitive(False)

        def worker() -> None:
            proc = subprocess.run(
                ["pkexec", "/usr/libexec/amelia-init-persistence"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
            )
            GLib.idle_add(self._on_init_persistence_done, btn, proc.returncode == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _on_init_persistence_done(self, btn: Gtk.Button, ok: bool) -> bool:
        btn.set_sensitive(True)
        self._show_toast(self.t("toast_persist_ok") if ok else self.t("toast_persist_fail"))
        return GLib.SOURCE_REMOVE

    def _on_copy_sysinfo(self, *_args: object) -> None:
        info_lines = [
            "System: Amelia (testing)",
            f"Mode: {self.boot_mode}",
            f"Kernel: {platform.release()}",
            f"Arch: {platform.machine()}",
            f"Session: {os.environ.get('XDG_SESSION_TYPE', 'wayland')}",
        ]
        display = Gdk.Display.get_default()
        if display is not None:
            display.get_clipboard().set("\n".join(info_lines))
            self._show_toast(self.t("toast_copied"))

    def _show_toast(self, message: str) -> None:
        toast = Adw.Toast.new(message)
        toast.set_timeout(4)
        self.toast_overlay.add_toast(toast)

    @staticmethod
    def _spawn(cmd: list[str]) -> None:
        try:
            subprocess.Popen(cmd, start_new_session=True)
        except OSError:
            pass


class AmeliaWelcomeApp(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self) -> None:
        win = self.props.active_window
        if not win:
            win = AmeliaWelcomeWindow(self)
        win.present()


def main() -> int:
    app = AmeliaWelcomeApp()
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())

