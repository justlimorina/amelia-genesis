    def _create_apps_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        groups = {
            "browser": Adw.PreferencesGroup(title=self.t("apps_browser_group")),
            "gaming": Adw.PreferencesGroup(title=self.t("apps_gaming_group")),
            "social": Adw.PreferencesGroup(title=self.t("apps_social_group")),
            "dev": Adw.PreferencesGroup(title=self.t("apps_dev_group")),
            "media": Adw.PreferencesGroup(title=self.t("apps_media_group")),
        }

        for app_info in POPULAR_APPS:
            cat = app_info.get("category", "dev")
            group = groups.get(cat, groups["dev"])

            app_id = app_info["id"]
            name = app_info["name"]
            desc = app_info[f"desc_{self.lang}"]

            row = Adw.ActionRow(title=name, subtitle=desc)
            row.add_prefix(Gtk.Image.new_from_icon_name(app_info["icon"]))

            is_installed = is_flatpak_app_installed(app_id)
            is_installing = app_id in self.installing_apps

            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            btn_box.set_valign(Gtk.Align.CENTER)

            spinner = Gtk.Spinner()
            spinner.set_visible(is_installing)
            if is_installing:
                spinner.start()
            btn_box.append(spinner)

            action_btn = Gtk.Button()
            action_btn.set_valign(Gtk.Align.CENTER)

            if is_installed:
                action_btn.set_label(self.t("app_open_btn"))
                action_btn.connect("clicked", lambda _b, aid=app_id: self._spawn(["flatpak", "run", aid]))
            elif is_installing:
                action_btn.set_label(self.t("app_installing_btn"))
                action_btn.set_sensitive(False)
            else:
                action_btn.set_label(self.t("app_install_btn"))
                action_btn.add_css_class("suggested-action")
                action_btn.connect("clicked", lambda _b, aid=app_id, aname=name: self._on_install_app_clicked(aid, aname))

            btn_box.append(action_btn)
            row.add_suffix(btn_box)
            group.add(row)

        for group in groups.values():
            page.add(group)

        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("apps_page_title"))

    def _on_install_app_clicked(self, app_id: str, app_name: str) -> None:
        if app_id in self.installing_apps:
            return

        self.installing_apps.add(app_id)
        self._show_toast(self.t("toast_app_start").format(name=app_name))
        self.nav_view.replace([self._create_main_page(), self._create_apps_page()])

        def worker() -> None:
            rc = 1
            if shutil.which("flatpak"):
                proc = subprocess.run(
                    ["flatpak", "install", "--noninteractive", "-y", "flathub", app_id],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    check=False,
                )
                rc = proc.returncode
                if rc != 0:
                    subprocess.run(
                        [
                            "flatpak",
                            "remote-add",
                            "--user",
                            "--if-not-exists",
                            "flathub",
                            "/etc/flatpak/remotes.d/flathub.flatpakrepo",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False,
                    )
                    proc2 = subprocess.run(
                        [
                            "flatpak",
                            "install",
                            "--user",
                            "--noninteractive",
                            "-y",
                            "flathub",
                            app_id,
                        ],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        check=False,
                    )
                    rc = proc2.returncode

            GLib.idle_add(self._on_app_install_finished, app_id, app_name, rc == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _on_app_install_finished(self, app_id: str, app_name: str, ok: bool) -> bool:
        self.installing_apps.discard(app_id)
        if ok:
            self._show_toast(self.t("toast_app_done").format(name=app_name))
        else:
            self._show_toast(self.t("toast_app_fail").format(name=app_name))

        self.nav_view.replace([self._create_main_page(), self._create_apps_page()])
        return GLib.SOURCE_REMOVE

    def _create_persistence_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        warn_group = Adw.PreferencesGroup()
        warn_row = Adw.ActionRow(
            title=self.t("persist_privacy_title"),
            subtitle=self.t("persist_privacy_desc"),
        )
        warn_row.add_prefix(Gtk.Image.new_from_icon_name("dialog-warning-symbolic"))
        warn_group.add(warn_row)
        page.add(warn_group)

        steps_group = Adw.PreferencesGroup(title=self.t("persist_steps_group"))

        step1 = Adw.ActionRow(
            title=self.t("persist_step1_title"),
            subtitle=self.t("persist_step1_sub"),
        )
        s1_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        s1_box.set_valign(Gtk.Align.CENTER)
        disks_btn = Gtk.Button(label=self.t("persist_disks_btn"))
        disks_btn.connect("clicked", lambda *_: self._spawn(["gnome-disks"]))
        s1_box.append(disks_btn)
        if shutil.which("gparted"):
            gp_btn = Gtk.Button(label=self.t("persist_gparted_btn"))
            gp_btn.connect("clicked", lambda *_: self._spawn(["pkexec", "gparted"]))
            s1_box.append(gp_btn)
        step1.add_suffix(s1_box)
        steps_group.add(step1)

        step2 = Adw.ActionRow(
            title=self.t("persist_step2_title"),
            subtitle=self.t("persist_step2_sub"),
        )
        init_btn = Gtk.Button(label=self.t("persist_init_btn"))
        init_btn.set_valign(Gtk.Align.CENTER)
        init_btn.add_css_class("suggested-action")
        init_btn.connect("clicked", self._on_init_persistence)
        step2.add_suffix(init_btn)
        steps_group.add(step2)

        step3 = Adw.ActionRow(
            title=self.t("persist_step3_title"),
            subtitle=self.t("persist_step3_sub"),
        )
        steps_group.add(step3)

        page.add(steps_group)
        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("persist_page_title"))

    def _create_hardware_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        net_group = Adw.PreferencesGroup(title=self.t("hw_net_group"))
        for title_k, sub_k, icon_name, panel in [
            ("hw_wifi_title", "hw_wifi_sub", "network-wireless-symbolic", "wifi"),
            ("hw_net_title", "hw_net_sub", "network-wired-symbolic", "network"),
            ("hw_bt_title", "hw_bt_sub", "bluetooth-active-symbolic", "bluetooth"),
        ]:
            row = Adw.ActionRow(title=self.t(title_k), subtitle=self.t(sub_k))
            row.add_prefix(Gtk.Image.new_from_icon_name(icon_name))
            btn = Gtk.Button(label=self.t("open_settings_btn"))
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("clicked", lambda _b, p=panel: self._spawn(["gnome-control-center", p]))
            row.add_suffix(btn)
            row.set_activatable_widget(btn)
            net_group.add(row)
        page.add(net_group)

        gpu_group = Adw.PreferencesGroup(title=self.t("hw_gpu_group"))
        disp_row = Adw.ActionRow(
            title=self.t("hw_disp_title"),
            subtitle=self.t("hw_disp_sub"),
        )
        disp_row.add_prefix(Gtk.Image.new_from_icon_name("video-display-symbolic"))
        disp_btn = Gtk.Button(label=self.t("open_settings_btn"))
        disp_btn.set_valign(Gtk.Align.CENTER)
        disp_btn.connect("clicked", lambda *_: self._spawn(["gnome-control-center", "display"]))
        disp_row.add_suffix(disp_btn)
        disp_row.set_activatable_widget(disp_btn)
        gpu_group.add(disp_row)

        # NVIDIA GPU Detection & 1-Click Driver Installer
        if detect_nvidia_gpu():
            nv_active = is_nvidia_driver_active()
            nv_row = Adw.ActionRow(
                title=self.t("hw_nvidia_title"),
                subtitle=self.t("hw_nvidia_sub_installed") if nv_active else self.t("hw_nvidia_sub"),
            )
            nv_row.add_prefix(Gtk.Image.new_from_icon_name("video-display-symbolic"))
            if nv_active:
                badge = Gtk.Label(label=self.t("hw_nvidia_installed_badge"))
                badge.add_css_class("amelia-badge")
                badge.set_valign(Gtk.Align.CENTER)
                nv_row.add_suffix(badge)
            else:
                nv_btn = Gtk.Button(label=self.t("hw_nvidia_btn"))
                nv_btn.set_valign(Gtk.Align.CENTER)
                nv_btn.add_css_class("suggested-action")
                nv_cmd = (
                    "ptyxis -- pkexec bash -c '"
                    "echo \"=== Installing NVIDIA Proprietary Driver & Firmware ===\"; "
                    "apt update && apt install -y nvidia-driver firmware-misc-nonfree; "
                    "echo -e \"\\n=== Installation Finished! Please reboot your computer. ===\"; "
                    "read -p \"Press Enter to close...\"'"
                )
                nv_btn.connect("clicked", lambda *_: self._spawn(["sh", "-c", nv_cmd]))
                nv_row.add_suffix(nv_btn)
                nv_row.set_activatable_widget(nv_btn)
            gpu_group.add(nv_row)

        drv_row = Adw.ActionRow(
            title=self.t("hw_drv_title"),
            subtitle=self.t("hw_drv_sub"),
        )
        drv_row.add_prefix(Gtk.Image.new_from_icon_name("preferences-desktop-display-symbolic"))
        gpu_group.add(drv_row)
        page.add(gpu_group)

        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("hw_page_title"))

    def _update_logo_file(self) -> None:
        if not hasattr(self, "logo_picture"):
            return
        candidate = DARK_WORDMARK if self.style_mgr.get_dark() else LIGHT_WORDMARK
        if not os.path.exists(candidate):
            candidate = FALLBACK_WORDMARK
        if os.path.exists(candidate):
            self.logo_picture.set_filename(candidate)

    def _sync_theme_visuals(self) -> None:
        if self.style_mgr.get_dark():
            self.remove_css_class("light-mode")
        else:
            self.add_css_class("light-mode")
        self._update_logo_file()

    def _on_theme_changed(self, *_args: object) -> None:
        self._sync_theme_visuals()

    def _on_toggle_language(self, *_args: object) -> None:
        self.lang = "en" if self.lang == "vi" else "vi"
        self.oo_installed = is_onlyoffice_installed()
        self._build_ui()
        self._sync_theme_visuals()

    def _on_startup_toggled(self, switch_row: Adw.SwitchRow, _pspec: object) -> None:
        flag = disable_flag_path()
        try:
            if switch_row.get_active():
                flag.unlink(missing_ok=True)
            else:
                flag.parent.mkdir(parents=True, exist_ok=True)
                flag.write_text("disabled\n", encoding="utf-8")
        except OSError:
            pass

    def _on_onlyoffice_primary_clicked(self, *_args: object) -> None:
        if is_onlyoffice_installed():
            self.oo_installed = True
            apply_onlyoffice_mime_defaults()
            self._spawn(["flatpak", "run", ONLYOFFICE_ID])
            return

        if self.oo_installing:
            return

        self.oo_installing = True
        self.oo_primary_btn.set_sensitive(False)
        self.oo_primary_btn.set_label(self.t("oo_installing_btn"))
        self.oo_spinner.set_visible(True)
        self.oo_spinner.start()
        self._show_toast(self.t("toast_oo_start"))

        def worker() -> None:
            rc = 1
            if shutil.which("flatpak"):
                proc = subprocess.run(
                    ["flatpak", "install", "--noninteractive", "-y", "flathub", ONLYOFFICE_ID],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    check=False,
                )
                rc = proc.returncode
                if rc != 0:
                    proc_user = subprocess.run(
                        [
                            "flatpak",
                            "remote-add",
                            "--user",
                            "--if-not-exists",
                            "flathub",
                            "/etc/flatpak/remotes.d/flathub.flatpakrepo",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False,
                    )
                    if proc_user.returncode == 0:
                        proc2 = subprocess.run(
                            [
                                "flatpak",
                                "install",
                                "--user",
                                "--noninteractive",
                                "-y",
                                "flathub",
                                ONLYOFFICE_ID,
                            ],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT,
                            text=True,
                            check=False,
                        )
                        rc = proc2.returncode

            GLib.idle_add(self._on_onlyoffice_install_finished, rc == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _on_onlyoffice_install_finished(self, ok: bool) -> bool:
        self.oo_installing = False
        self.oo_installed = ok or is_onlyoffice_installed()
        if self.oo_installed:
            apply_onlyoffice_mime_defaults()
            self._show_toast(self.t("toast_oo_done"))
        else:
            self._show_toast(self.t("toast_oo_fail"))
        self._build_ui()
        self._sync_theme_visuals()
        return GLib.SOURCE_REMOVE

    def _on_init_persistence(self, btn: Gtk.Button) -> None:
        btn.set_sensitive(False)

        def worker() -> None:
            proc = subprocess.run(
                ["pkexec", "/usr/libexec/amelia-init-persistence"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
            )
            GLib.idle_add(self._on_init_persistence_done, btn, proc.returncode == 0)

        threading.Thread(target=worker, daemon=True).start()

    def _on_init_persistence_done(self, btn: Gtk.Button, ok: bool) -> bool:
        btn.set_sensitive(True)
        self._show_toast(self.t("toast_persist_ok") if ok else self.t("toast_persist_fail"))
        return GLib.SOURCE_REMOVE

    def _create_nix_page(self) -> Adw.NavigationPage:
        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(Adw.HeaderBar())

        page = Adw.PreferencesPage()

        status_group = Adw.PreferencesGroup(title=self.t("nix_status_group"))
        sock_ready = Path("/nix/var/nix/daemon-socket/socket").exists()
        daemon_row = Adw.ActionRow(
            title=self.t("nix_daemon_title"),
            subtitle=self.t("nix_daemon_active") if sock_ready else self.t("nix_daemon_ready"),
        )
        daemon_row.add_prefix(Gtk.Image.new_from_icon_name("emblem-system-symbolic"))
        term_btn = Gtk.Button(label=self.t("nix_term_btn"))
        term_btn.set_valign(Gtk.Align.CENTER)
        term_btn.connect("clicked", lambda *_: self._spawn(["ptyxis"]))
        daemon_row.add_suffix(term_btn)
        daemon_row.set_activatable_widget(term_btn)
        status_group.add(daemon_row)

        upg_row = Adw.ActionRow(
            title=self.t("nix_upgrade_title"),
            subtitle=self.t("nix_upgrade_sub"),
        )
        upg_row.add_prefix(Gtk.Image.new_from_icon_name("software-update-available-symbolic"))
        upg_btn = Gtk.Button(label=self.t("nix_upgrade_btn"))
        upg_btn.set_valign(Gtk.Align.CENTER)
        upg_cmd = (
            "ptyxis -- bash -lc '"
            "echo \"=== Upgrading Nix User Profile Packages ===\"; "
            "nix profile upgrade --all; "
            "echo \"\"; read -p \"Press Enter to close...\"'"
        )
        upg_btn.connect("clicked", lambda *_: self._spawn(["sh", "-c", upg_cmd]))
        upg_row.add_suffix(upg_btn)
        upg_row.set_activatable_widget(upg_btn)
        status_group.add(upg_row)

        gc_row = Adw.ActionRow(
            title=self.t("nix_gc_title"),
            subtitle=self.t("nix_gc_sub"),
        )
        gc_row.add_prefix(Gtk.Image.new_from_icon_name("user-trash-symbolic"))
        gc_btn = Gtk.Button(label=self.t("nix_gc_btn"))
        gc_btn.set_valign(Gtk.Align.CENTER)
        gc_cmd = (
            "ptyxis -- bash -lc '"
            "echo \"=== Cleaning Unused Nix Store Generations ===\"; "
            "nix-collect-garbage -d; "
            "echo \"\"; read -p \"Press Enter to close...\"'"
        )
        gc_btn.connect("clicked", lambda *_: self._spawn(["sh", "-c", gc_cmd]))
        gc_row.add_suffix(gc_btn)
        gc_row.set_activatable_widget(gc_btn)
        status_group.add(gc_row)
        page.add(status_group)

        cmd_group = Adw.PreferencesGroup(title=self.t("nix_cmd_group"))
        nix_examples = [
            ("Search Nixpkgs", "Tìm kiếm gói trên Nixpkgs", "nix search nixpkgs fastfetch"),
            ("Install Package to Profile", "Cài gói vào môi trường cá nhân", "nix profile install nixpkgs#neovim"),
            ("Run Ephemeral App Without Installing", "Chạy thử gói ngay không cần cài đặt", "nix run nixpkgs#btop"),
            ("List Installed Nix Packages", "Xem danh sách gói Nix đã cài", "nix profile list"),
        ]
        for en_title, vi_title, cmd_str in nix_examples:
            row = Adw.ActionRow(
                title=vi_title if self.lang == "vi" else en_title,
                subtitle=cmd_str,
            )
            row.add_prefix(Gtk.Image.new_from_icon_name("utilities-terminal-symbolic"))
            c_btn = Gtk.Button(label=self.t("nix_copy_btn"))
            c_btn.set_valign(Gtk.Align.CENTER)
            c_btn.connect("clicked", lambda _b, c=cmd_str: self._copy_text(c))
            row.add_suffix(c_btn)
            row.set_activatable_widget(c_btn)
            cmd_group.add(row)
        page.add(cmd_group)

        toolbar_view.set_content(page)
        return Adw.NavigationPage.new(toolbar_view, self.t("nix_page_title"))

    def _copy_text(self, text: str) -> None:
        display = Gdk.Display.get_default()
        if display is not None:
            display.get_clipboard().set(text)
            self._show_toast(self.t("toast_cmd_copied").format(cmd=text))

    def _on_copy_sysinfo(self, *_args: object) -> None:
        os_rel: dict[str, str] = {}
        try:
            for line in Path("/etc/os-release").read_text(encoding="utf-8", errors="ignore").splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    os_rel[k.strip()] = v.strip().strip('"')
        except OSError:
            pass
        pretty = os_rel.get("PRETTY_NAME", "Amelia Linux: Nicole")
        codename = os_rel.get("VERSION_CODENAME", "nicole")
        deb_codename = os_rel.get("DEBIAN_CODENAME", "stable")
        nix_ver = "not installed"
        if shutil.which("nix"):
            proc = subprocess.run(["nix", "--version"], stdout=subprocess.PIPE, text=True, check=False)
            if proc.returncode == 0 and proc.stdout.strip():
                nix_ver = proc.stdout.strip()
        info_lines = [
            f"System: {pretty} (codename={codename}, debian_codename={deb_codename})",
            f"Mode: {self.boot_mode}",
            f"Nix: {nix_ver}",
            f"Kernel: {platform.release()}",
            f"Arch: {platform.machine()}",
            f"Session: {os.environ.get('XDG_SESSION_TYPE', 'wayland')}",
        ]
        display = Gdk.Display.get_default()
        if display is not None:
            display.get_clipboard().set("\n".join(info_lines))
            self._show_toast(self.t("toast_copied"))

    def _show_toast(self, message: str) -> None:
        toast = Adw.Toast.new(message)
        toast.set_timeout(4)
        self.toast_overlay.add_toast(toast)

    @staticmethod
    def _spawn(cmd: list[str]) -> None:
        try:
            subprocess.Popen(cmd, start_new_session=True)
        except OSError:
            pass


class AmeliaWelcomeApp(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self) -> None:
        win = self.props.active_window
        if not win:
            win = AmeliaWelcomeWindow(self)
        win.present()


def main() -> int:
    app = AmeliaWelcomeApp()
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
