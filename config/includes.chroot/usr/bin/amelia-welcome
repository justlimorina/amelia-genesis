    font-size: 0.85em;
    background-color: alpha(#6750A4, 0.18);
    color: #D0BCFF;
}
window.light-mode .amelia-badge {
    background-color: alpha(#6750A4, 0.12);
    color: #4F378B;
}
.amelia-badge-persist {
    background-color: alpha(#7D5260, 0.28);
}
"""


def detect_boot_mode() -> str:
    """Return 'live', 'persistence', or 'installed'."""
    cmdline = ""
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8", errors="ignore")
    except OSError:
        pass

    tokens = cmdline.split()
    if "boot=live" not in tokens:
        return "installed"

    try:
        mounts = Path("/proc/mounts").read_text(encoding="utf-8", errors="ignore")
        for line in mounts.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1].startswith("/run/live/persistence/"):
                return "persistence"
    except OSError:
        pass

    return "live"


def detect_initial_lang() -> str:
    env_lang = os.environ.get("LANG", "") or os.environ.get("LC_ALL", "")
    if not env_lang:
        try:
            env_lang = locale.getlocale()[0] or ""
        except Exception:
            env_lang = ""
    return "vi" if env_lang.lower().startswith("vi") else "en"


def is_flatpak_app_installed(app_id: str) -> bool:
    exports = [
        Path(f"/var/lib/flatpak/exports/share/applications/{app_id}.desktop"),
        Path.home() / f".local/share/flatpak/exports/share/applications/{app_id}.desktop",
    ]
    if any(p.exists() for p in exports):
        return True
    if shutil.which("flatpak"):
        res = subprocess.run(
            ["flatpak", "info", app_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    return False


def is_onlyoffice_installed() -> bool:
    return is_flatpak_app_installed(ONLYOFFICE_ID)


def apply_onlyoffice_mime_defaults() -> None:
    if not shutil.which("xdg-mime"):
        return
    desktop_id = f"{ONLYOFFICE_ID}.desktop"
    for mime in OFFICE_MIMES:
        subprocess.run(
            ["xdg-mime", "default", desktop_id, mime],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def detect_nvidia_gpu() -> bool:
    try:
        proc = subprocess.run(["lspci"], stdout=subprocess.PIPE, text=True, check=False)
        for line in proc.stdout.splitlines():
            line_l = line.lower()
            if ("vga" in line_l or "3d" in line_l or "display" in line_l) and "nvidia" in line_l:
                return True
    except OSError:
        pass
    return False


def is_nvidia_driver_active() -> bool:
    if shutil.which("nvidia-smi"):
        res = subprocess.run(["nvidia-smi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return res.returncode == 0
    return False


def disable_flag_path() -> Path:
    cfg = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    return cfg / "amelia" / "welcome-disabled"


class AmeliaWelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application) -> None:
        super().__init__(application=app)
        self.set_default_size(700, 720)
        self.set_size_request(380, 520)

        self.boot_mode = detect_boot_mode()
        self.lang = detect_initial_lang()
        self.oo_installing = False
        self.oo_installed = is_onlyoffice_installed()
        self.installing_apps: set[str] = set()

        self.style_mgr = Adw.StyleManager.get_default()
        self.style_mgr.connect("notify::dark", self._on_theme_changed)

        self.toast_overlay = Adw.ToastOverlay()
        self.nav_view = Adw.NavigationView()
        self.toast_overlay.set_child(self.nav_view)
        self.set_content(self.toast_overlay)

        self._load_css()
        self._build_ui()
        self._sync_theme_visuals()

    def t(self, key: str) -> str:
        return STRINGS[self.lang].get(key, key)

    def _load_css(self) -> None:
        provider = Gtk.CssProvider()
        provider.load_from_string(CUSTOM_CSS)
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def _build_ui(self) -> None:
        main_page = self._create_main_page()
        self.nav_view.replace([main_page])
        self.set_title(self.t("window_title"))

