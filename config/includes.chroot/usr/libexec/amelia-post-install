#!/bin/sh
set -e

# 1. Remove Live-only installer launchers, wrappers, sudoers, and USB persistence helpers
rm -f /etc/skel/Desktop/install-amelia.desktop
rm -f /home/*/Desktop/install-amelia.desktop
rm -f /usr/share/applications/install-amelia.desktop
rm -f /usr/local/bin/install-amelia
rm -f /etc/sudoers.d/live-user
rm -f /etc/gdm3/custom.conf
rm -f /usr/libexec/amelia-init-persistence
rm -f /usr/share/polkit-1/actions/org.amelia.persistence.policy

# Clean up any leftover live 'user' home directory if Calamares created a different user
if ! id user >/dev/null 2>&1 && [ -d /home/user ]; then
    rm -rf /home/user
fi

# 2. Update GNOME favorite-apps on installed system (remove install-amelia.desktop)
SCHEMA_OVERRIDE="/usr/share/glib-2.0/schemas/99_amelia_settings.gschema.override"
if [ -f "$SCHEMA_OVERRIDE" ]; then
    sed -i "s/'install-amelia.desktop', //" "$SCHEMA_OVERRIDE" || true
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas || true
    fi
fi

# 3. Write clean Debian testing APT sources (hardcoded to 'testing' per Amelia policy)
cat > /etc/apt/sources.list << 'EOF'
deb http://deb.debian.org/debian/ testing main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian/ testing main contrib non-free non-free-firmware

deb http://security.debian.org/debian-security/ testing-security main contrib non-free non-free-firmware
deb-src http://security.debian.org/debian-security/ testing-security main contrib non-free non-free-firmware

deb http://deb.debian.org/debian/ testing-updates main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian/ testing-updates main contrib non-free non-free-firmware
EOF

# 4. Ensure LUKS initramfs permissions remain strict if /etc/crypttab has entries
if [ -f /etc/crypttab ] && grep -Eqv '^[[:space:]]*(#|$)' /etc/crypttab; then
    mkdir -p /etc/initramfs-tools/conf.d
    echo "UMASK=0077" > /etc/initramfs-tools/conf.d/initramfs-permissions
    chmod 0600 /crypto_keyfile.bin 2>/dev/null || true
fi

# 5. Re-verify GRUB menu uses exact "Amelia Linux" branding and OS prober is enabled
if [ -f /etc/grub.d/10_linux ] && ! grep -q 'Amelia\*|Ubuntu' /etc/grub.d/10_linux; then
    sed -i 's/Ubuntu|\*GNU\/Linux)/Amelia*|Ubuntu|*GNU\/Linux)/' /etc/grub.d/10_linux || true
fi
if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then
    update-grub || true
fi

# Self-delete post-install helper
rm -f /usr/libexec/amelia-post-install
exit 0

