#!/bin/sh
set -e

echo "Setting up Calamares desktop launcher and cleaning duplicate Debian launchers..."

# Remove/divert duplicate Debian Calamares launchers (red Debian swirl icon on dock/desktop)
for dup in \
    /usr/share/applications/calamares-install-debian.desktop \
    /etc/xdg/autostart/calamares-desktop-icon.desktop
do
    if ! dpkg-divert --list "$dup" 2>/dev/null | grep -q "$dup"; then
        dpkg-divert --local --rename --divert "${dup}.disabled" --add "$dup" || true
    fi
    rm -f "$dup" || true
done

if [ -f /etc/skel/Desktop/install-amelia.desktop ]; then
    chmod +x /etc/skel/Desktop/install-amelia.desktop
fi

if [ -d /home/user ]; then
    mkdir -p /home/user/Desktop
    cp /etc/skel/Desktop/install-amelia.desktop /home/user/Desktop/
    chmod +x /home/user/Desktop/install-amelia.desktop
    chown -R user:user /home/user/Desktop || true
fi
