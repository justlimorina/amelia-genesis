#!/bin/sh
set -e

echo "Ensuring Flatpak & Flathub configuration..."
mkdir -p /etc/flatpak/remotes.d
chmod 644 /etc/flatpak/remotes.d/flathub.flatpakrepo || true

if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo 2>/dev/null || true
fi

